{
  "name": "alipanbuddy",
  "description": "AlipanBuddy (神行云盘助手) - Aliyun Drive desktop client",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "author": {
    "name": "programfan",
    "email": "zyang1984@gmail.com"
  },
  "homepage": "https://github.com/programfan/alipanbuddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/programfan/alipanbuddy.git"
  },
  "license": "GPL-3.0",
  "scripts": {
    "secrets:generate": "node scripts/generate-secrets.mjs --mode=local",
    "sidecars": "node scripts/prepare-sidecars.mjs",
    "predev": "node scripts/generate-secrets.mjs --mode=local",
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "prebuild:renderer": "node scripts/generate-secrets.mjs --mode=local",
    "build:renderer": "vue-tsc --noEmit && vite build",
    "build:debug": "tauri build --debug --no-bundle",
    "build:linux": "tauri build --no-bundle && bash scripts/build-linux-packages.sh",
    "build:windows": "tauri build --bundles nsis",
    "build:windows:arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "metrics": "node scripts/metrics.mjs",
    "pretest": "node scripts/generate-secrets.mjs --mode=local",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p alipancore"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "2.55.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.12.5",
    "@types/secp256k1": "^4.0.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "axios": "^1.6.8",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "dexie": "^4.0.1",
    "fuzzysort": "^2.0.4",
    "jschardet": "^3.1.2",
    "less": "^4.2.0",
    "lucide-vue-next": "^1.0.0",
    "mime-db": "^1.53.0",
    "pinia": "^2.1.7",
    "secp256k1": "^5.0.0",
    "typescript": "^5.4.4",
    "uuid-by-string": "^4.0.0",
    "viewerjs": "^1.11.6",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue": "3.4.21",
    "vue-tsc": "^2.0.10"
  },
  "keywords": [
    "tauri",
    "vite",
    "vue3",
    "vue",
    "alipan",
    "alipanbuddy"
  ]
}
