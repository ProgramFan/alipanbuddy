{
  "name": "boxplayer",
  "description": "BoxPlayer - Aliyun Drive desktop client",
  "version": "5.0.25",
  "main": "dist/electron/main/index.js",
  "packageManager": "pnpm@10.32.1",
  "author": {
    "name": "gaozhangmin",
    "email": "gaozhangmin@gmail.com"
  },
  "homepage": "https://github.com/gaozhangmin/aliyunpan",
  "license": "GPL-3.0",
  "scripts": {
    "secrets:generate": "node scripts/generate-secrets.mjs --mode=local",
    "predev": "node scripts/generate-secrets.mjs --mode=local",
    "dev": "vite",
    "prebuild": "node scripts/generate-secrets.mjs --mode=local",
    "build": "node version.mjs && vue-tsc --noEmit && vite build",
    "build:version": "node version.mjs",
    "build:electron": "pnpm run build && electron-builder",
    "build:test": "pnpm run build && electron-builder --dir",
    "build:mac": "pnpm run build && PYTHON=/usr/bin/python3 electron-builder --mac",
    "build:mac:signed": "pnpm run build && PYTHON=/usr/bin/python3 CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --mac",
    "build:linux": "pnpm run build && node build-linux.mjs",
    "build:windows": "pnpm run build && electron-builder --win",
    "build:windows:arm64": "pnpm run build && electron-builder --win --arm64",
    "build:all": "node build-all.mjs",
    "pretest": "node scripts/generate-secrets.mjs --mode=local",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "2.55.1",
    "@arco-themes/vue-gi-demo": "^0.0.48",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@motrix/nat-api": "0.3.4",
    "@types/crypto-js": "^4.2.2",
    "@types/howler": "^2.2.11",
    "@types/lodash": "^4.17.0",
    "@types/markdown-it": "^14.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.12.5",
    "@types/secp256k1": "^4.0.6",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "ai": "^6.0.197",
    "ant-design-vue": "4.1.2",
    "aria2-lib": "1.0.1",
    "axios": "^1.6.8",
    "builder-util-runtime": "^9.5.1",
    "consola": "^3.2.3",
    "cookie": "^0.6.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "dexie": "^4.0.1",
    "dom-to-image": "^2.6.0",
    "electron": "40.10.6",
    "electron-builder": "^26.15.3",
    "electron-is": "^3.0.0",
    "electron-store": "8.2.0",
    "electron-updater": "^6.8.3",
    "epubjs": "^0.3.93",
    "fix-path": "^4.0.0",
    "fuzzysort": "^2.0.4",
    "howler": "^2.2.4",
    "jschardet": "^3.1.2",
    "lazy-val": "^1.0.5",
    "less": "^4.2.0",
    "lodash": "^4.17.21",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "mime-types": "^2.1.35",
    "perf_hooks": "^0.0.1",
    "pinia": "^2.1.7",
    "secp256k1": "^5.0.0",
    "semver": "^7.6.0",
    "socks-proxy-agent": "^8.0.3",
    "terser": "^5.30.3",
    "tree-kill": "^1.2.2",
    "typescript": "^5.4.4",
    "uuid": "^9.0.1",
    "uuid-by-string": "^4.0.0",
    "viewerjs": "^1.11.6",
    "vite": "5.2.8",
    "vite-plugin-electron": "0.15.6",
    "vite-plugin-electron-renderer": "0.14.5",
    "vitest": "^2.1.9",
    "vue": "3.4.21",
    "vue-tsc": "^2.0.10"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_HOSTNAME": "127.0.0.1",
      "VITE_DEV_SERVER_PORT": 5173,
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:5173"
    }
  },
  "keywords": [
    "aliyunpan",
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "pnpm": {
    "overrides": {
      "@electron/get": "3.1.0"
    }
  }
}
